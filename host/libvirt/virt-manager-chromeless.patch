+
+    # Hydrix: no window decoration, menu bar and toolbar hidden until the menu
+    # key is tapped on its own (like Alt in Firefox). Key events still reach
+    # the guest: these handlers only watch and never consume them.
+    def _hydrix_setup_chromeless(self):
+        self._hydrix_chrome = False
+        self._hydrix_menu_tap = False
+        self.topwin.set_decorated(False)
+        self._hydrix_apply_chrome()
+        self.topwin.connect("key-press-event", self._hydrix_key_press_cb)
+        self.topwin.connect("key-release-event", self._hydrix_key_release_cb)
+
+    def _hydrix_apply_chrome(self):
+        fs = self.widget("details-menu-view-fullscreen").get_active()
+        show = self._hydrix_chrome and not fs
+        self.widget("details-menubar").set_visible(show)
+        self.widget("toolbar-box").set_visible(
+            show and self.widget("details-menu-view-toolbar").get_active()
+        )
+
+    def _hydrix_key_press_cb(self, src, event):
+        # A tap only counts with no other modifier already held, so a combination such as
+        # Alt+AltGr (a grab key) never toggles the menus whatever the release order.
+        held = event.state & (
+            Gdk.ModifierType.SHIFT_MASK
+            | Gdk.ModifierType.CONTROL_MASK
+            | Gdk.ModifierType.MOD1_MASK
+            | Gdk.ModifierType.MOD4_MASK
+            | Gdk.ModifierType.MOD5_MASK
+            | Gdk.ModifierType.SUPER_MASK
+        )
+        self._hydrix_menu_tap = (
+            Gdk.keyval_name(event.keyval) == self._HYDRIX_MENU_KEY and not held
+        )
+        return False
+
+    def _hydrix_key_release_cb(self, src, event):
+        if self._hydrix_menu_tap and Gdk.keyval_name(event.keyval) == self._HYDRIX_MENU_KEY:
+            self._hydrix_chrome = not self._hydrix_chrome
+            self._hydrix_apply_chrome()
+        self._hydrix_menu_tap = False
+        return False
+
     @property
     def conn(self):

+/** Client mode with `--vsock --socket CID:port`: accept connections only from that CID.
+ * Without an explicit CID (the spec defaults to VMADDR_CID_HOST) any peer is accepted. */
+#[cfg(target_os = "linux")]
+fn vsock_peer_allowed(fd: RawFd, spec: &SocketSpec) -> bool {
+    let SocketSpec::VSock(v) = spec else {
+        return true;
+    };
+    if v.cid == VMADDR_CID_HOST {
+        return true;
+    }
+    match socket::getpeername::<socket::VsockAddr>(fd) {
+        Ok(addr) if addr.cid() == v.cid => true,
+        Ok(addr) => {
+            error!(
+                "Rejected vsock connection from CID {}, expected {}",
+                addr.cid(),
+                v.cid
+            );
+            false
+        }
+        Err(_) => false,
+    }
+}
+#[cfg(not(target_os = "linux"))]
+fn vsock_peer_allowed(_fd: RawFd, _spec: &SocketSpec) -> bool {
+    true
+}
